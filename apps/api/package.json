    "@hono/zod-validator": "^0.9.0",
    "@repo/db": "workspace:*",
    "@repo/shared": "workspace:*",
    "ai": "^7.0.66",
    "dotenv": "^16.6.1",
    "hono": "^4.13.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "tsup": "^8.5.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  }
