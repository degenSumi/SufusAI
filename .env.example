# ---------------------------------------------------------------------------
# Database — Neon Postgres (https://neon.tech → new project → connection string)
# Use the POOLED connection string. Must include ?sslmode=require
# ---------------------------------------------------------------------------
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require"

# ---------------------------------------------------------------------------
# AI provider
#
# The app talks to models through the Vercel AI SDK, so the provider is a
# swappable implementation detail. Pick one and set its key:
#
#   google     → GOOGLE_GENERATIVE_AI_API_KEY   (https://aistudio.google.com/apikey)
#   openai     → OPENAI_API_KEY
#   openrouter → OPENROUTER_API_KEY             (any model, OpenAI-compatible)
#   gateway    → AI_GATEWAY_API_KEY             (Vercel AI Gateway)
# ---------------------------------------------------------------------------
AI_PROVIDER="google"
GOOGLE_GENERATIVE_AI_API_KEY=""

# Optional model overrides. Defaults are chosen per provider in
# apps/api/src/agents/provider.ts — router uses a fast/cheap model, sub-agents
# use a stronger one, summarisation uses the cheapest.
# ROUTER_MODEL="gemini-3.5-flash-lite"
# AGENT_MODEL="gemini-3.5-flash"
# SUMMARY_MODEL="gemini-3.5-flash-lite"

# ---------------------------------------------------------------------------
# Fallback provider (optional but recommended on a free-tier key)
#
# When the primary provider fails with a retryable error — quota, rate limit,
# model retired — the model layer transparently retries once against this
# model on OpenRouter. Gemini's free tier allows roughly 20 requests per day
# per model and a single turn costs two, so without this a demo runs dry.
#
# Set both to enable; leave OPENROUTER_API_KEY empty to disable.
# Key: https://openrouter.ai/keys
# Must be a free model that supports tool calling.
# ---------------------------------------------------------------------------
OPENROUTER_API_KEY=""
FALLBACK_MODEL="poolside/laguna-s-2.1:free"

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
PORT="3001"
NODE_ENV="development"

# Rate limiting (sliding window)
RATE_LIMIT_WINDOW_MS="60000"
RATE_LIMIT_MAX_REQUESTS="30"

# Context management — when a conversation exceeds the token budget, older
# turns are compacted into a rolling summary.
CONTEXT_TOKEN_BUDGET="6000"
CONTEXT_KEEP_RECENT_MESSAGES="8"

# ---------------------------------------------------------------------------
# Frontend
# ---------------------------------------------------------------------------
VITE_API_URL="http://localhost:3001"
